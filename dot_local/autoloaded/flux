# description: Generate an image locally with FLUX.2 klein (mflux). Usage: flux [-9b] <prompt>

local model="flux2-klein-4b"
if [[ "$1" == "-9b" ]]; then
    model="flux2-klein-9b"
    shift
fi

if [[ -z "$1" ]]; then
    echo "usage: flux [-9b] <prompt>"
    return 1
fi

local outdir="$HOME/Pictures/flux-test"
mkdir -p "$outdir"
local outfile="$outdir/$(date +%Y%m%d-%H%M%S).png"

mflux-generate-flux2 --model "$model" --prompt "$*" --steps 4 --width 1024 --height 1024 --output "$outfile" \
    && open "$outfile"
